# Copy this file to ".env" and edit as needed. Every line is OPTIONAL —
# the app has sensible defaults, so an empty .env (or no .env at all) works.
# These names must match exactly what app/config.py reads.

# Optional openFDA API key — raises the rate limit. Anonymous use works fine
# without it. Free key: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Base URLs for the data sources (override only for testing/mocking).
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_BASE_URL=https://api.fda.gov

# HTTP behaviour for the upstream API calls.
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2

# How many drugs to RETURN per symptom lookup (after ranking).
MAX_LABELS_PER_LOOKUP=5

# How many drugs to fetch+score BEFORE ranking/truncating. Keep this larger
# than MAX_LABELS_PER_LOOKUP so a good drug isn't cut before it's scored.
CANDIDATE_POOL_SIZE=15
